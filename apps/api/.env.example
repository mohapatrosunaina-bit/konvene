# Postgres connection string (Supabase project). Use the "Transaction pooler"
# URI from Supabase Dashboard -> Project Settings -> Database -> Connection
# string (port 6543, ?pgbouncer=true) — required for serverless deployment,
# and works fine for local dev too.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

QR_SIGNING_SECRET="change-me-to-a-long-random-string"

PORT=4000
# Comma-separated list of allowed frontend origins (CORS).
WEB_ORIGIN="http://localhost:3000"

# Required — Supabase Auth owns login/signup (password hashing, sessions,
# token issuance), and Supabase Storage holds certificate PDFs. Get these
# from Supabase Dashboard -> Project Settings -> API Keys. The service_role
# key is a secret with full admin access — never expose it to the frontend.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Phase 1+ (not required now)
RESEND_API_KEY=""
